# AMR agent and kiosk settings on this robot, read by the amr-agent and
# amr-kiosk services. install_robot.sh writes /etc/amr/robot.env from this on first run;
# edit it there, then: sudo systemctl restart amr-agent amr-kiosk

# ── Robot agent ──────────────────────────────────────────────────────────────
# The id the web UI shows for this robot (Robot → the robot → Details).
AMR_ROBOT_ID=
# The server, through its web container: http://<server>/backend
AMR_BACKEND_URL=
# This robot's ROS workspace (custom_interfaces is built there).
AMR_ROS_WS=/home/robot/ros2_gprp_amr_ws
AMR_ROS_DISTRO=jazzy
ROS_DOMAIN_ID=10
# Seconds a `confirm` stop waits for "Sudah diambil" before driving on.
AMR_CONFIRM_TIMEOUT=120

# ── Kiosk ────────────────────────────────────────────────────────────────────
AMR_KIOSK_NAME=AMR
# Staff PIN for the kiosk's staff menu. Change it.
AMR_KIOSK_PIN=1234
# Extra kiosk options, e.g. "--lang en --estop-topic /estop".
AMR_KIOSK_ARGS=
# Offline voice: path to a Piper voice (.onnx). Empty: espeak-ng, or none.
AMR_KIOSK_PIPER_MODEL=
# Sound player: aplay works from a service without a desktop session.
AMR_KIOSK_PLAYER=aplay

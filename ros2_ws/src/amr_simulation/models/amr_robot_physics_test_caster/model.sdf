<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Disposable diagnostic candidate. It is not the Cafe AMR production model. -->
  <model name="amr_robot_physics_test_caster">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="chassis">
      <pose>0 0 0.14 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.54 0.50 0.12</size></box></geometry>
        <material><ambient>0.08 0.16 0.30 1</ambient><diffuse>0.12 0.24 0.48 1</diffuse></material>
      </visual>
      <collision name="collision"><geometry><box><size>0.54 0.50 0.12</size></box></geometry></collision>
      <inertial>
        <!-- Single-variable balance test: move COM 50 mm toward rear caster. -->
        <pose>-0.05 0 0 0 0 0</pose>
        <mass>10.0</mass>
        <inertia><ixx>0.220</ixx><iyy>0.255</iyy><izz>0.448</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>

    <link name="wheel_left_link">
      <pose>0 0.21 0.09 -1.5707963 0 0</pose>
      <visual name="visual"><geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry></visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.035</slip1><slip2>0.0</slip2></ode></friction></surface>
      </collision>
      <inertial><mass>0.5</mass><inertia><ixx>0.00110</ixx><iyy>0.00110</iyy><izz>0.00203</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <joint name="wheel_left_joint" type="revolute">
      <parent>chassis</parent><child>wheel_left_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>20</effort></limit></axis>
    </joint>

    <link name="wheel_right_link">
      <pose>0 -0.21 0.09 -1.5707963 0 0</pose>
      <visual name="visual"><geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry></visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.035</slip1><slip2>0.0</slip2></ode></friction></surface>
      </collision>
      <inertial><mass>0.5</mass><inertia><ixx>0.00110</ixx><iyy>0.00110</iyy><izz>0.00203</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <joint name="wheel_right_joint" type="revolute">
      <parent>chassis</parent><child>wheel_right_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>20</effort></limit></axis>
    </joint>

    <!-- Explicit three-point support: 40 mm ball, centre 250 mm behind axle. -->
    <link name="caster_link">
      <pose>-0.25 0 0.04 0 0 0</pose>
      <visual name="visual"><geometry><sphere><radius>0.04</radius></sphere></geometry></visual>
      <collision name="collision">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <surface><friction><ode><mu>0.20</mu><mu2>0.20</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode></friction></surface>
      </collision>
      <inertial><mass>0.2</mass><inertia><ixx>0.00013</ixx><iyy>0.00013</iyy><izz>0.00013</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <joint name="caster_joint" type="ball"><parent>chassis</parent><child>caster_link</child></joint>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_left_joint</joint_name><joint_name>wheel_right_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint><right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.42</wheel_separation><wheel_radius>0.09</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration><min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration><min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>0.6</max_linear_velocity><min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity><min_angular_velocity>-1.2</min_angular_velocity>
    </plugin>
  </model>
</sdf>

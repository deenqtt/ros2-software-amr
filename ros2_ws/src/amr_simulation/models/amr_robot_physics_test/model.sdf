<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Disposable diagnostic model. It is not the Cafe AMR production model. -->
  <model name="amr_robot_physics_test">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- One rigid chassis, kept above the plane so only wheels/support contact. -->
    <link name="chassis">
      <pose>0 0 0.14 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.54 0.50 0.12</size></box></geometry>
        <material>
          <ambient>0.08 0.16 0.30 1</ambient>
          <diffuse>0.12 0.24 0.48 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.54 0.50 0.12</size></box></geometry>
      </collision>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.220</ixx>
          <iyy>0.255</iyy>
          <izz>0.448</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- The wheel cylinder's native axis is local Z. Roll -pi/2 maps it to Y. -->
    <link name="wheel_left_link">
      <pose>0 0.21 0.09 -1.5707963 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.035</slip1><slip2>0.0</slip2></ode></friction></surface>
      </collision>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.00110</ixx><iyy>0.00110</iyy><izz>0.00203</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="wheel_left_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_left_link</child>
      <!-- No pose: joint frame is co-located with the child link frame. -->
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>20</effort></limit>
      </axis>
    </joint>

    <link name="wheel_right_link">
      <pose>0 -0.21 0.09 -1.5707963 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.035</slip1><slip2>0.0</slip2></ode></friction></surface>
      </collision>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.00110</ixx><iyy>0.00110</iyy><izz>0.00203</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="wheel_right_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_right_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>20</effort></limit>
      </axis>
    </joint>

    <!-- Diagnostic-only joint position/velocity telemetry. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>

    <!-- No passive support in this first minimal candidate: only the two drive wheels contact the plane. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.42</wheel_separation>
      <wheel_radius>0.09</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity>
      <min_angular_velocity>-1.2</min_angular_velocity>
    </plugin>
  </model>
</sdf>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cafe_service_amr">
  <material name="chassis_blue"><color rgba="0.12 0.20 0.30 1.0"/></material>
  <material name="tray_wood"><color rgba="0.64 0.38 0.16 1.0"/></material>
  <material name="dark"><color rgba="0.04 0.04 0.05 1.0"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.165" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <visual><geometry><box size="0.54 0.62 0.12"/></geometry><material name="chassis_blue"/></visual>
    <collision><geometry><box size="0.54 0.62 0.12"/></geometry></collision>
    <inertial><origin xyz="0 0 0.015"/><mass value="18.0"/><inertia ixx="0.594" ixy="0" ixz="0" iyy="0.522" iyz="0" izz="1.014"/></inertial>
  </link>

  <link name="tray_1"><visual><geometry><box size="0.46 0.42 0.025"/></geometry><material name="tray_wood"/></visual><collision><geometry><box size="0.46 0.42 0.025"/></geometry></collision><inertial><mass value="1.2"/><inertia ixx="0.018" ixy="0" ixz="0" iyy="0.022" iyz="0" izz="0.039"/></inertial></link>
  <joint name="tray_1_joint" type="fixed"><parent link="base_link"/><child link="tray_1"/><origin xyz="0 0 0.315"/></joint>
  <link name="tray_2"><visual><geometry><box size="0.46 0.42 0.025"/></geometry><material name="tray_wood"/></visual><collision><geometry><box size="0.46 0.42 0.025"/></geometry></collision><inertial><mass value="1.2"/><inertia ixx="0.018" ixy="0" ixz="0" iyy="0.022" iyz="0" izz="0.039"/></inertial></link>
  <joint name="tray_2_joint" type="fixed"><parent link="base_link"/><child link="tray_2"/><origin xyz="0 0 0.595"/></joint>
  <link name="tray_3"><visual><geometry><box size="0.46 0.42 0.025"/></geometry><material name="tray_wood"/></visual><collision><geometry><box size="0.46 0.42 0.025"/></geometry></collision><inertial><mass value="1.2"/><inertia ixx="0.018" ixy="0" ixz="0" iyy="0.022" iyz="0" izz="0.039"/></inertial></link>
  <joint name="tray_3_joint" type="fixed"><parent link="base_link"/><child link="tray_3"/><origin xyz="0 0 0.875"/></joint>

  <link name="wheel_left_link"><visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.09" length="0.045"/></geometry><material name="dark"/></visual><collision><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.09" length="0.045"/></geometry></collision></link>
  <joint name="wheel_left_joint" type="continuous"><parent link="base_link"/><child link="wheel_left_link"/><origin xyz="0 -0.21 -0.075"/><axis xyz="0 1 0"/></joint>
  <link name="wheel_right_link"><visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.09" length="0.045"/></geometry><material name="dark"/></visual><collision><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.09" length="0.045"/></geometry></collision></link>
  <joint name="wheel_right_joint" type="continuous"><parent link="base_link"/><child link="wheel_right_link"/><origin xyz="0 0.21 -0.075"/><axis xyz="0 1 0"/></joint>

  <link name="base_scan"/>
  <joint name="scan_joint" type="fixed"><parent link="base_link"/><child link="base_scan"/><origin xyz="0 0 0.085"/></joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.085"/></joint>
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.255 0 0.815"/></joint>
  <link name="camera_rgb_frame"/>
  <joint name="camera_rgb_joint" type="fixed"><parent link="camera_link"/><child link="camera_rgb_frame"/><origin xyz="0 0 0"/></joint>
  <link name="camera_rgb_optical_frame"/>
  <joint name="camera_rgb_optical_joint" type="fixed"><parent link="camera_rgb_frame"/><child link="camera_rgb_optical_frame"/><origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/></joint>
</robot>

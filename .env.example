# Copy to `.env`. Not committed — each machine, and each robot, has its own.
#
# On a real robot these live in a config file written once at commissioning
# (/etc/amr/agent.env, loaded by systemd). Nobody types them.

# Where the fleet registry lives. A hostname in production, not an IP: robots
# outlive servers, and re-addressing twenty robots by hand is a bad afternoon.
AMR_BACKEND_URL=http://localhost:3002

# Which robot this is. Created by the UI when the robot is registered.
AMR_ROBOT_ID=

# Gazebo display. Leave unset on a robot — there is no screen.
SIM_GUI=true
SIM_HEADLESS=false

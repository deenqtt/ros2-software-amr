# nginx for the AMR web UI on the server — one origin for the browser.
#
#   /            the built frontend (new_webui/frontend/dist), SPA fallback
#   /backend/    the FastAPI backend on this machine, prefix stripped — and,
#                through it, every robot: the browser opens
#                /backend/api/robots/<id>/ros and the backend relays that to the
#                robot's rosbridge after checking the session and every frame.
#
# There is deliberately no /robot/<name> proxy to rosbridge any more. rosbridge
# has no authentication: anything that can open its port can drive the robot,
# whatever role its user has. Firewall each robot's rosbridge port (9090) so
# only this server can reach it, e.g. on the robot:
#   sudo ufw allow from <this-server-ip> to any port 9090 proto tcp
#   sudo ufw deny 9090/tcp
# and register the robot with its direct address (bridge_url ws://<jetson>:9090),
# which the backend uses and browsers are never given.
#
# Copy to /etc/nginx/sites-available/amr, adjust server_name, paths and robot
# addresses, then: ln -s ../sites-available/amr /etc/nginx/sites-enabled/ &&
# nginx -t && systemctl reload nginx
#
# Build the frontend with .env.production (see .env.production.example) so it
# calls /backend/api — relative, so the same build works under any host name.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name amr.example.local;

    root /opt/amr/web/dist;
    index index.html;

    # Map uploads are a PGM plus its YAML; a large warehouse map is tens of MB.
    client_max_body_size 64m;

    # ── Frontend ────────────────────────────────────────────────────────────
    location / {
        # Client-side routes (/robot/…/nav, /missions, …) all serve the app.
        try_files $uri $uri/ /index.html;
    }

    # Hashed assets never change under the same name; cache them hard.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ── Backend ─────────────────────────────────────────────────────────────
    # Trailing slash on proxy_pass strips /backend: /backend/api/runs reaches
    # the backend as /api/runs. Robots may use this too:
    #   run_agent_gprp.sh <robot_id> http://amr.example.local/backend
    #
    # Also carries the robots' ROS WebSockets (/backend/api/robots/<id>/ros), so
    # it upgrades connections and keeps idle ones open for an hour. Host keeps
    # the port: the backend compares it with the browser's Origin to refuse
    # pages from other sites. X-Real-IP is what the audit trail records.
    location /backend/ {
        proxy_pass http://127.0.0.1:3002/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── Robots ──────────────────────────────────────────────────────────────
    # No direct rosbridge proxies here. An old `location /robot/<name>` block
    # that proxies to a robot's :9090 must be removed: it lets any browser drive
    # the robot without signing in. See the note at the top of this file.
}

# AMR web UI — settings for this site. Copy to .env next to docker-compose.yml.
# Never commit the filled-in file: it holds the first admin password.

# Image tag to run: a release such as 1.2.0, or latest.
AMR_VERSION=latest
# Port the web UI is served on.
AMR_HTTP_PORT=80

AMR_ENV=production
# Every address the UI is opened from, comma-separated. Required in production.
AMR_CORS_ORIGINS=http://amr.local,http://192.168.10.5

# Sign-in. true only when served over HTTPS (a TLS proxy in front); over plain
# HTTP the browser drops a secure cookie and every sign-in appears to fail.
AMR_COOKIE_SECURE=false
AMR_SESSION_IDLE_MINUTES=720
AMR_AUDIT_RETENTION_DAYS=180
# Robot agents must present their own bearer token (web UI: Robot -> Details ->
# Agent token; the robot keeps it as AMR_AGENT_TOKEN in /etc/amr/robot.env).
# Keep this at "required". "optional" lets anything without credentials act as a
# robot agent, and the backend refuses to start with it while AMR_ENV=production.
AMR_AGENT_AUTH=required
#
# UPGRADING an existing site: agents authenticate now, so before you update
#   1. sign in as an admin, open each robot -> Details -> Agent token, generate
#      one (shown once) and put it on that robot: AMR_AGENT_TOKEN in
#      /etc/amr/robot.env, then `sudo systemctl restart amr-agent`
#      (or push_to_robot.sh <robot> --agent-token <token>);
#   2. change any existing .env that says AMR_AGENT_AUTH=optional to required,
#      or the backend will not start;
#   3. firewall each robot's rosbridge (9090) so only this server can reach it.
# Robots without a token are refused until step 1 is done for them.

# First super admin, used only while the database has no accounts at all.
# It must set its own password at the first sign-in; delete both lines then.
AMR_BOOTSTRAP_USER=admin
AMR_BOOTSTRAP_PASSWORD=change-me-on-first-sign-in

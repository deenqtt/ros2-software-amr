# AMR web UI — settings for this site. Copy to .env next to docker-compose.yml.
# Never commit the filled-in file: it holds the first admin password.

# Image tag to run: a release such as 1.2.0, or latest.
AMR_VERSION=latest
# Port the web UI is served on.
AMR_HTTP_PORT=80

AMR_ENV=production
# Every address the UI is opened from, comma-separated. Required in production.
AMR_CORS_ORIGINS=http://amr.local,http://192.168.10.5

# Sign-in. true only when served over HTTPS (a TLS proxy in front); over plain
# HTTP the browser drops a secure cookie and every sign-in appears to fail.
AMR_COOKIE_SECURE=false
AMR_SESSION_IDLE_MINUTES=720
AMR_AUDIT_RETENTION_DAYS=180
# optional: robot agents may call their endpoints without credentials (all of
# them do today). required: refuse them until they carry a token.
AMR_AGENT_AUTH=optional

# First super admin, used only while the database has no accounts at all.
# It must set its own password at the first sign-in; delete both lines then.
AMR_BOOTSTRAP_USER=admin
AMR_BOOTSTRAP_PASSWORD=change-me-on-first-sign-in

# Optional: proxy each robot's rosbridge through the web container, so browsers
# need not reach the Jetsons directly. Copy to /opt/amr/nginx/robots.conf, one
# block per robot, then `docker compose restart web`. The robot's bridge URL in
# the registry is then ws://<server>/robot/<name> (wss:// behind HTTPS).

location /robot/amr-02 {
    proxy_pass http://192.168.10.21:9090;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    # rosbridge connections live for hours; idle ones must not be cut.
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

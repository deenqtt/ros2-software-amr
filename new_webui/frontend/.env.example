# Backend REST API base. The old UI hardcoded http://localhost:3001/api,
# which broke any deployment where the backend was not on the operator's
# own machine. Keep this configurable.
VITE_API_BASE_URL=http://localhost:3002/api

# Backend static file root (map images).
VITE_API_STATIC_URL=http://localhost:3002

# Default rosbridge WebSocket, used only to seed the robot registry on a
# fresh install. Per-robot bridge URLs live in the registry, not here.
VITE_DEFAULT_ROS_URL=ws://localhost:8765

# Default camera stream base for a newly registered robot.
VITE_DEFAULT_CAMERA_PORT=8080

# Development aid only. Adds an artificial delay to registry loads so the
# skeleton and empty states can be exercised while the data is still local.
# Leave at 0 for anything that is not local development.
VITE_DEV_LATENCY_MS=0

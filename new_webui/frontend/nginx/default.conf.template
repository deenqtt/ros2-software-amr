# Plain HTTP (the default). Rendered by the nginx image at start-up from
# /etc/nginx/templates: ${AMR_BACKEND_URL} comes from the environment (see
# frontend/Dockerfile and deploy/docker-compose.yml). The locations themselves
# are in locations.inc.template, shared with tls.conf.template (HTTPS, chosen
# with deploy/docker-compose.tls.yml).

# No nginx version in the Server header or on any error page.
server_tokens off;

# Errors nginx itself produces under /backend/ (backend down, timed out, upload
# too large): a page someone opened in the browser gets the AMR error page; the
# app's own requests (fetch sends Accept: */*) and the ROS relay WebSocket get
# JSON {"detail": ...}, the shape every API error already has.
map $http_accept $amr_error_ext {
    "~*text/html"  html;
    default        json;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Strict-Transport-Security value for security-headers.conf: over HTTPS only.
# Empty here in practice (this server is HTTP), so no HSTS header is sent.
map $scheme $amr_hsts {
    https   "max-age=31536000";
    default "";
}

# Used by amr-security-headers.conf: ws:/wss: for this site's own host in
# connect-src. Only a plain host[:port] is copied into the header; anything
# else (a crafted Host) leaves just 'self'.
map $http_host $amr_ws_self {
    "~^[A-Za-z0-9.-]+(:[0-9]+)?$"  "ws://$http_host wss://$http_host";
    "~^\[[0-9A-Fa-f:.]+\](:[0-9]+)?$" "ws://$http_host wss://$http_host";
    default "";
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/amr/security-headers.conf;
    include /etc/nginx/conf.d/locations.inc;
}

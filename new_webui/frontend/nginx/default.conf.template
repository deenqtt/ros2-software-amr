# Rendered by the nginx image at start-up: ${AMR_BACKEND_URL} comes from the
# environment (see frontend/Dockerfile and deploy/docker-compose.yml).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Map uploads are a PGM plus its YAML; a large warehouse map is tens of MB.
    client_max_body_size 64m;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Client-side routes (/robot/…/nav, /missions, …) all serve the app.
    # index.html itself is never cached, so a new release is picked up on the
    # next load.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Hashed assets never change under the same name; cache them hard.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Trailing slash strips /backend: /backend/api/runs reaches the backend as
    # /api/runs. Robots use this too: run_agent_gprp.sh <id> http://<host>/backend
    #
    # Browsers also reach the robots through here: /backend/api/robots/<id>/ros
    # is a WebSocket the backend relays to that robot's rosbridge after checking
    # the session and every frame. Hence the upgrade headers and the long
    # timeouts (a robot page stays open for hours; the relay closes it itself
    # when the session ends). $http_host keeps the port, which the backend
    # compares against the Origin header to refuse other sites' pages.
    location /backend/ {
        proxy_pass ${AMR_BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Per-site extras, mounted from the host. Not for rosbridge: a direct
    # /robot/<name> proxy would bypass the backend's checks (see
    # deploy/robots.conf.example).
    include /etc/nginx/amr.d/*.conf;
}

# HTTPS, served by the web container itself. Installed in the image as
# /etc/nginx/templates-tls/default.conf.template and chosen by
# deploy/docker-compose.tls.yml (NGINX_ENVSUBST_TEMPLATE_DIR). Rendered at
# start-up: ${AMR_BACKEND_URL} and ${AMR_HTTPS_PORT} come from the environment.
#
# Certificate: /etc/nginx/certs/fullchain.pem and privkey.pem, mounted from
# ./certs next to docker-compose.yml. The key must be readable by the nginx
# user (uid 101). See docs/runbooks/PRODUCTION_DEPLOYMENT.md, "HTTPS".

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $scheme $amr_hsts {
    https   "max-age=31536000";
    default "";
}

# Port 80: everything goes to HTTPS. 308, not 301: it keeps the method and
# body, so a POST is not silently turned into a GET. /healthz stays on HTTP for
# the container's own health check.
server {
    listen 8080;
    server_name _;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 308 https://$host:${AMR_HTTPS_PORT}$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:amr_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    # Includes Strict-Transport-Security here: $scheme is https.
    include /etc/nginx/amr/security-headers.conf;
    include /etc/nginx/conf.d/locations.inc;
}

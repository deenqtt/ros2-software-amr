# ── Storage ──────────────────────────────────────────────────────────────────
AMR_DB_PATH=./data/amr.db
# Map files (.yaml + .pgm). Shared with the ROS container in docker-compose.
AMR_MAPS_DIR=./data/maps
# Same directory as the ROS container sees it. Differs from AMR_MAPS_DIR when
# the two run in different containers with different mount points.
AMR_ROS_MAPS_PATH=/maps

# ── HTTP ─────────────────────────────────────────────────────────────────────
AMR_HOST=0.0.0.0
# 3002 so this runs alongside the existing backend on 3001.
AMR_PORT=3002

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. The old backend shipped allow_origins=["*"] with no
# authentication on a host-network container, which meant anyone with network
# reach could drive the robot. Name the origins you actually serve.
AMR_CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# ── Sign-in ──────────────────────────────────────────────────────────────────
# A session ends after this many minutes without a request. 720 = one shift.
AMR_SESSION_IDLE_MINUTES=720
# true only when the site is served over HTTPS; over plain HTTP the browser
# would drop the cookie and every sign-in would appear to fail.
AMR_COOKIE_SECURE=false
# required (default): a robot agent must send its own token as
#   Authorization: Bearer <token>
# and may then act only for that one robot. An admin mints the token with
#   POST /api/robots/<robot-id>/agent-token
# which returns it once (only its hash is stored); calling it again rotates the
# token, and DELETE on the same path revokes it. Put the token in the agent's
# configuration on the robot.
# optional: additionally treat a request with no credentials at all as an agent.
# Local development only; the server refuses to start with it in production.
AMR_AGENT_AUTH=required
# Audit records older than this are deleted at startup.
AMR_AUDIT_RETENTION_DAYS=365

# First super admin on a NEW server. Used only while the database has no
# accounts at all; ignored afterwards. The account must set its own password
# at first sign-in, after which this one stops working — remove both lines then.
# AMR_BOOTSTRAP_USER=superadmin
# AMR_BOOTSTRAP_PASSWORD=change-me-at-first-sign-in

# ── Environment ──────────────────────────────────────────────────────────────
# development | production. Production refuses to start on an unsafe CORS config.
AMR_ENV=development

# ── Production, behind nginx (new_webui/deploy/nginx.conf.example) ───────────
# The browser and the robots then reach this API only through nginx at
# http://<server>/backend, so it need not listen on the network itself, and the
# browser makes same-origin calls that CORS never applies to. The origin list
# must still name the site (it is refused when empty):
#
#   AMR_ENV=production
#   AMR_HOST=127.0.0.1
#   AMR_CORS_ORIGINS=http://amr.example.local
#
# Without nginx, keep AMR_HOST=0.0.0.0 so robots can reach :3002 directly, and
# list every origin the UI is opened from, e.g. http://192.168.10.5:3100.

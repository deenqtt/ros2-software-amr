# ── Storage ──────────────────────────────────────────────────────────────────
AMR_DB_PATH=./data/amr.db
# Map files (.yaml + .pgm). Shared with the ROS container in docker-compose.
AMR_MAPS_DIR=./data/maps
# Same directory as the ROS container sees it. Differs from AMR_MAPS_DIR when
# the two run in different containers with different mount points.
AMR_ROS_MAPS_PATH=/maps

# ── HTTP ─────────────────────────────────────────────────────────────────────
AMR_HOST=0.0.0.0
# 3002 so this runs alongside the existing backend on 3001.
AMR_PORT=3002

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. The old backend shipped allow_origins=["*"] with no
# authentication on a host-network container, which meant anyone with network
# reach could drive the robot. Name the origins you actually serve.
AMR_CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# ── Environment ──────────────────────────────────────────────────────────────
# development | production. Production refuses to start on an unsafe CORS config.
AMR_ENV=development
